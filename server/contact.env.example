# Copy to /etc/novica-contact.env on the server, fill in, then:
#   chmod 600 /etc/novica-contact.env
#   systemctl restart novica-contact
#
# This file holds secrets -- it lives on the server only, never in git.

# Which channels to deliver through: telegram, email, or both (comma-separated).
# Leave empty/unset to auto-enable every channel whose credentials are filled in below.
CHANNELS=telegram,email

# --- Telegram ---
# Bot token from @BotFather. Chat id: message the bot once, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and read result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (Resend) ---
# Without a verified domain, Resend only allows sending to your own account
# address -- which is exactly what this does, so the free tier works as is.
# With a verified domain you can change MAIL_FROM to something like
#   Portfolio <contact@novicatrifkovic.com>
RESEND_API_KEY=
MAIL_TO=novicatrifkovic@gmail.com
MAIL_FROM=Portfolio Contact <onboarding@resend.dev>

# --- Optional ---
# PORT=8787
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=3600000
